---
import content from '../data/content.json';
const { team } = content;
---

<style>
  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
    margin-top: var(--space-lg);
  }
  .team-card {
    position: relative;
    overflow: hidden;
    cursor: pointer;
  }
  .team-image {
    width: 100%;
    aspect-ratio: 3 / 4;
    background: var(--color-surface);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    transition: all 0.4s ease;
  }
  .team-card:hover .team-image {
    background: var(--color-accent-dim);
  }
  .team-image-placeholder {
    font-family: var(--font-display);
    font-size: 4rem;
    color: var(--color-border);
    transition: color 0.4s ease;
  }
  .team-card:hover .team-image-placeholder {
    color: var(--color-accent);
  }
  .team-image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 60%, var(--color-bg) 100%);
  }
  .team-info {
    padding: var(--space-sm) 0;
  }
  .team-name {
    font-family: var(--font-display);
    font-size: 1.5rem;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }
  .team-role {
    font-size: 1rem;
    color: var(--color-text-muted);
    margin-top: 0.25rem;
  }
  .team-social {
    display: flex;
    gap: var(--space-sm);
    margin-top: var(--space-xs);
  }
  .team-social a {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    transition: color 0.3s ease;
  }
  .team-social a:hover {
    color: var(--color-accent);
  }
  @media (max-width: 768px) {
    .team-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<section class="section" id="team">
  <div class="container">
    <span class="section-label reveal">{team.label}</span>
    <h2 class="section-title reveal reveal-delay-1">{team.title}</h2>
    <div class="team-grid">
      {
        team.members.map((member, i) => (
          <div class={`team-card reveal reveal-delay-${i + 1}`}>
            <div class="team-image">
              <span class="team-image-placeholder">{member.initials}</span>
              <div class="team-image-overlay"></div>
            </div>
            <div class="team-info">
              <h3 class="team-name">{member.name}</h3>
              <p class="team-role">{member.role}</p>
              <div class="team-social">
                {
                  member.socials.map((social) => (
                    <a href={social.url}>{social.label}</a>
                  ))
                }
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
