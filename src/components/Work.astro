---
import content from '../data/content.json';
const { work } = content;
---

<style>
  .work-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--color-border);
    margin-top: var(--space-lg);
  }
  .work-card {
    background: var(--color-bg);
    padding: var(--space-lg) var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    position: relative;
    overflow: hidden;
    transition: background 0.4s ease;
    cursor: pointer;
  }
  .work-card:hover {
    background: var(--color-surface);
  }
  .work-card:hover .work-arrow {
    transform: translate(4px, -4px);
    opacity: 1;
  }
  .work-card-tag {
    font-family: var(--font-display);
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .work-card-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3vw, 2.75rem);
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    flex: 1;
  }
  .work-card-desc {
    font-size: 1rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }
  .work-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }
  .work-card-type {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .work-arrow {
    font-size: 1.25rem;
    color: var(--color-accent);
    transition: all 0.3s ease;
    opacity: 0.5;
  }
  .work-cta-wrap {
    text-align: center;
    margin-top: var(--space-lg);
  }
  .work-cta {
    font-family: var(--font-display);
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-accent);
    border: 2px solid var(--color-accent);
    padding: 1rem 2.5rem;
    display: inline-block;
    transition: all 0.3s ease;
  }
  .work-cta:hover {
    background: var(--color-accent);
    color: #ffffff;
  }
  @media (max-width: 768px) {
    .work-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<section class="section" id="work">
  <div class="container">
    <span class="section-label reveal">{work.label}</span>
    <h2 class="section-title reveal reveal-delay-1">{work.title}</h2>
    <div class="work-grid">
      {
        work.projects.map((project, i) => (
          <div class={`work-card reveal reveal-delay-${i + 1}`}>
            <span class="work-card-tag">{project.tag}</span>
            <h3 class="work-card-title">{project.title}</h3>
            <p class="work-card-desc">{project.description}</p>
            <div class="work-card-footer">
              <span class="work-card-type">{project.type}</span>
              <span class="work-arrow">↗</span>
            </div>
          </div>
        ))
      }
    </div>
    <div class="work-cta-wrap reveal">
      <a href="#" class="work-cta">{work.cta}</a>
    </div>
  </div>
</section>
