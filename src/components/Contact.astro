---
import content from '../data/content.json';
const { contact } = content;
---

<style>
  .contact {
    background: var(--color-bg-alt);
    border-top: 1px solid var(--color-border);
    text-align: center;
    padding: var(--space-2xl) 0;
    position: relative;
    overflow: hidden;
  }
  .contact::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, var(--color-accent-dim) 0%, transparent 60%);
    opacity: 0.5;
  }
  .contact > * {
    position: relative;
    z-index: 1;
  }
  .contact-cta {
    display: inline-block;
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 6rem);
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: -0.03em;
    color: var(--color-text);
    border: 4px solid var(--color-text);
    padding: var(--space-md) var(--space-xl);
    margin-top: var(--space-lg);
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }
  .contact-cta::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-accent);
    transform: translateY(100%);
    transition: transform 0.4s ease;
    z-index: -1;
  }
  .contact-cta:hover::before {
    transform: translateY(0);
  }
  .contact-cta:hover {
    border-color: var(--color-accent);
    color: #ffffff;
    transform: scale(1.02);
  }
  .contact-sub {
    font-size: 1.25rem;
    color: var(--color-text-muted);
    margin-top: var(--space-md);
    max-width: 45ch;
    margin-left: auto;
    margin-right: auto;
  }
  .contact-links {
    display: flex;
    justify-content: center;
    gap: var(--space-lg);
    margin-top: var(--space-lg);
    flex-wrap: wrap;
  }
  .contact-link {
    font-family: var(--font-display);
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-text-muted);
    transition: color 0.3s ease;
  }
  .contact-link:hover {
    color: var(--color-accent);
  }
</style>

<section class="contact" id="contact">
  <div class="container">
    <span class="section-label reveal">{contact.label}</span>
    <h2 class="section-title reveal reveal-delay-1">{contact.title}</h2>
    <a href="mailto:hello@studio.com" class="contact-cta reveal reveal-delay-2">
      {contact.cta}
    </a>
    <p class="contact-sub reveal reveal-delay-3">{contact.subtitle}</p>
    <div class="contact-links reveal reveal-delay-4">
      {
        contact.links.map((link) => (
          <a href={link.url} class="contact-link">{link.label}</a>
        ))
      }
    </div>
  </div>
</section>
