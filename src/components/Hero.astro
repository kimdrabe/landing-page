<style>
  .hero {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    position: relative;
    overflow: hidden;
  }
  .hero-left {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-xl) var(--space-md) var(--space-xl) var(--space-md);
    padding-left: clamp(var(--space-md), 5vw, var(--space-xl));
    position: relative;
    z-index: 2;
  }
  .hero-label {
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-sm);
    opacity: 0;
    animation: fadeInUp 0.8s ease forwards;
    animation-delay: 0.1s;
  }
  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 10vw, 8rem);
    line-height: 0.88;
    text-transform: uppercase;
    letter-spacing: -0.03em;
    opacity: 0;
    animation: fadeInUp 0.8s ease forwards;
    animation-delay: 0.3s;
  }
  .hero-title .accent {
    color: var(--color-accent);
    display: block;
  }
  .hero-sub {
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    color: var(--color-text-muted);
    margin-top: var(--space-md);
    max-width: 32ch;
    line-height: 1.7;
    opacity: 0;
    animation: fadeInUp 0.8s ease forwards;
    animation-delay: 0.5s;
  }
  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
    font-family: var(--font-display);
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-bg);
    background: var(--color-accent);
    padding: 1rem 2.5rem;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    opacity: 0;
    animation: fadeInUp 0.8s ease forwards;
    animation-delay: 0.7s;
    position: relative;
    overflow: hidden;
  }
  .hero-cta:hover {
    transform: scale(1.05);
    box-shadow: 0 0 40px rgba(204, 255, 0, 0.3);
  }
  .hero-cta::after {
    content: '→';
    font-size: 1.25rem;
    transition: transform 0.3s ease;
  }
  .hero-cta:hover::after {
    transform: translateX(6px);
  }
  .hero-right {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }
  .hero-diagonal {
    position: absolute;
    inset: 0;
    background: var(--color-bg-alt);
    clip-path: polygon(25% 0, 100% 0, 100% 100%, 0% 100%);
    z-index: 1;
  }
  .hero-diagonal-accent {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, transparent 40%, var(--color-accent-dim) 100%);
    clip-path: polygon(25% 0, 100% 0, 100% 100%, 0% 100%);
    z-index: 1;
  }
  .hero-stats {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
    padding: var(--space-lg);
    opacity: 0;
    animation: fadeInUp 0.8s ease forwards;
    animation-delay: 0.6s;
  }
  .hero-stat {
    text-align: center;
  }
  .hero-stat-number {
    font-family: var(--font-display);
    font-size: clamp(3rem, 5vw, 4.5rem);
    line-height: 1;
    color: var(--color-accent);
    display: block;
  }
  .hero-stat-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-text-muted);
    margin-top: 0.5rem;
    display: block;
  }
  .hero-scroll {
    position: absolute;
    bottom: var(--space-md);
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    opacity: 0;
    animation: fadeInUp 0.8s ease forwards;
    animation-delay: 1s;
  }
  .hero-scroll a {
    font-family: var(--font-display);
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }
  .hero-scroll-line {
    width: 1px;
    height: 40px;
    background: var(--color-text-muted);
    animation: scrollPulse 2s ease infinite;
  }
  @keyframes scrollPulse {
    0%, 100% { opacity: 0.3; transform: scaleY(1); }
    50% { opacity: 1; transform: scaleY(1.5); }
  }
  @media (max-width: 768px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .hero-right { display: none; }
    .hero-left { padding-top: 6rem; }
  }
</style>

<section class="hero" id="hero">
  <div class="hero-left">
    <span class="hero-label">Est. 2020</span>
    <h1 class="hero-title">
      We Design<br>
      <span class="accent">For the Bold</span>
    </h1>
    <p class="hero-sub">
      A brutalist web design studio crafting digital experiences that refuse to blend in. We work with founders and brands who have something to say.
    </p>
    <a href="#contact" class="hero-cta">Start a Project</a>
  </div>
  <div class="hero-right">
    <div class="hero-diagonal"></div>
    <div class="hero-diagonal-accent"></div>
    <div class="hero-stats">
      <div class="hero-stat">
        <span class="hero-stat-number">8+</span>
        <span class="hero-stat-label">Years Experience</span>
      </div>
      <div class="hero-stat">
        <span class="hero-stat-number">120+</span>
        <span class="hero-stat-label">Projects Delivered</span>
      </div>
      <div class="hero-stat">
        <span class="hero-stat-number">40+</span>
        <span class="hero-stat-label">Global Clients</span>
      </div>
      <div class="hero-stat">
        <span class="hero-stat-number">3x</span>
        <span class="hero-stat-label">Awwwards Nom.</span>
      </div>
    </div>
  </div>
  <div class="hero-scroll">
    <a href="#philosophy">
      <span>Scroll</span>
      <div class="hero-scroll-line"></div>
    </a>
  </div>
</section>
